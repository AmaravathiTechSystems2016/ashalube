<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fsm_order" model="ir.sequence">
        <field name="name">Field Service Order</field>
        <field name="code">fsm.order</field>
        <field name="prefix">FSM/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fsm_equipment" model="ir.sequence">
        <field name="name">Field Service Equipment</field>
        <field name="code">fsm.equipment</field>
        <field name="prefix">EQ/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fsm_installation" model="ir.sequence">
        <field name="name">Field Service Installation</field>
        <field name="code">fsm.installation</field>
        <field name="prefix">INST/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
