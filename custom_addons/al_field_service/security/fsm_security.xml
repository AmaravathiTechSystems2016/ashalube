<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_fsm">
        <field name="name">Field Service</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_fsm_user" model="res.groups">
        <field name="name">Technician</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_fsm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
        <field name="comment">Create and work assigned field service orders.</field>
    </record>

    <record id="group_fsm_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="res_groups_privilege_fsm"/>
        <field name="implied_ids" eval="[(4, ref('group_fsm_user'))]"/>
        <field name="comment">Plan, assign and monitor all work orders.</field>
    </record>

    <record id="group_fsm_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_fsm"/>
        <field name="implied_ids" eval="[(4, ref('group_fsm_dispatcher')), (4, ref('project.group_project_manager')), (4, ref('sales_team.group_sale_salesman')), (4, ref('stock.group_stock_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure teams, SLA, templates and billing policy.</field>
    </record>

    <record id="fsm_order_comp_rule" model="ir.rule">
        <field name="name">FSM Order multi-company</field>
        <field name="model_id" ref="model_fsm_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="fsm_order_user_rule" model="ir.rule">
        <field name="name">FSM Order: technician sees assigned jobs</field>
        <field name="model_id" ref="model_fsm_order"/>
        <field name="groups" eval="[(4, ref('group_fsm_user'))]"/>
        <field name="domain_force">['|', '|', ('technician_ids.user_id', '=', user.id), ('supervisor_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

    <record id="fsm_order_dispatcher_rule" model="ir.rule">
        <field name="name">FSM Order: dispatcher sees all</field>
        <field name="model_id" ref="model_fsm_order"/>
        <field name="groups" eval="[(4, ref('group_fsm_dispatcher'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="fsm_order_portal_rule" model="ir.rule">
        <field name="name">FSM Order: portal customer</field>
        <field name="model_id" ref="model_fsm_order"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', user.commercial_partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
