<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_material_line_view_list" model="ir.ui.view">
        <field name="name">fsm.material.line.list</field>
        <field name="model">fsm.material.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_uom_qty" sum="Qty"/>
                <field name="product_uom_id"/>
                <field name="price_unit"/>
                <field name="price_subtotal" sum="Subtotal"/>
            </list>
        </field>
    </record>
    <record id="fsm_material_line_view_form" model="ir.ui.view">
        <field name="name">fsm.material.line.form</field>
        <field name="model">fsm.material.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="order_id"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="product_uom_qty"/>
                    <field name="product_uom_id"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal"/>
                </group>
            </form>
        </field>
    </record>
    <record id="fsm_material_action" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">fsm.material.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
