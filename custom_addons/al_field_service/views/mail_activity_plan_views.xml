<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_plan_action_fsm" model="ir.actions.act_window">
        <field name="name">Activity Plans</field>
        <field name="res_model">mail.activity.plan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'fsm.order')]</field>
        <field name="context">{'default_res_model': 'fsm.order'}</field>
    </record>
    <record id="mail_activity_type_action_fsm" model="ir.actions.act_window">
        <field name="name">Activity Types</field>
        <field name="res_model">mail.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
