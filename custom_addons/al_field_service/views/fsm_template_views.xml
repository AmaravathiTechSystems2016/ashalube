<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_order_template_view_list" model="ir.ui.view">
        <field name="name">fsm.order.template.list</field>
        <field name="model">fsm.order.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_type"/>
                <field name="team_id"/>
                <field name="allocated_hours" widget="float_time"/>
            </list>
        </field>
    </record>
    <record id="fsm_order_template_view_form" model="ir.ui.view">
        <field name="name">fsm.order.template.form</field>
        <field name="model">fsm.order.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="job_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="team_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="checklist_template_id"/>
                            <field name="worksheet_template_id"/>
                            <field name="service_product_id"/>
                            <field name="allocated_hours" widget="float_time"/>
                            <field name="skill_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Default job instructions..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_order_template_action" model="ir.actions.act_window">
        <field name="name">Job Templates</field>
        <field name="res_model">fsm.order.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
