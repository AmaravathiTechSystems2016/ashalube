<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_timesheet_view_list" model="ir.ui.view">
        <field name="name">fsm.timesheet.list</field>
        <field name="model">fsm.timesheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="order_id"/>
                <field name="employee_id"/>
                <field name="description"/>
                <field name="hours" sum="Hours" widget="float_time"/>
                <field name="hourly_cost"/>
                <field name="total_cost" sum="Cost"/>
            </list>
        </field>
    </record>
    <record id="fsm_timesheet_action" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">fsm.timesheet</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
