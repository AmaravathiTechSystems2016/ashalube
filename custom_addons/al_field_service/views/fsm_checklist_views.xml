<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_checklist_template_view_form" model="ir.ui.view">
        <field name="name">fsm.checklist.template.form</field>
        <field name="model">fsm.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="is_mandatory"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_checklist_template_view_list" model="ir.ui.view">
        <field name="name">fsm.checklist.template.list</field>
        <field name="model">fsm.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">fsm.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
