<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_maintenance_plan_view_list" model="ir.ui.view">
        <field name="name">fsm.maintenance.plan.list</field>
        <field name="model">fsm.maintenance.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="interval"/>
                <field name="interval_unit"/>
                <field name="next_date"/>
                <field name="order_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_maintenance_plan_view_form" model="ir.ui.view">
        <field name="name">fsm.maintenance.plan.form</field>
        <field name="model">fsm.maintenance.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_order" type="object" string="Generate Work Order" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="location_id"/>
                            <field name="equipment_id"/>
                            <field name="team_id"/>
                            <field name="project_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="interval"/>
                            <field name="interval_unit"/>
                            <field name="next_date"/>
                            <field name="last_generated_date"/>
                            <field name="allocated_hours"/>
                            <field name="checklist_template_id"/>
                            <field name="worksheet_template_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="fsm_maintenance_plan_action" model="ir.actions.act_window">
        <field name="name">Preventive Maintenance Plans</field>
        <field name="res_model">fsm.maintenance.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
