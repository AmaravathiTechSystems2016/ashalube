<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_worksheet_template_view_form" model="ir.ui.view">
        <field name="name">fsm.worksheet.template.form</field>
        <field name="model">fsm.worksheet.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="worksheet_count"/>
                        </group>
                    </group>
                    <separator string="Service worksheet"/>
                    <field name="body" placeholder="Default worksheet content..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_worksheet_template_view_list" model="ir.ui.view">
        <field name="name">fsm.worksheet.template.list</field>
        <field name="model">fsm.worksheet.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="worksheet_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_worksheet_template_action" model="ir.actions.act_window">
        <field name="name">Worksheet Templates</field>
        <field name="res_model">fsm.worksheet.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
