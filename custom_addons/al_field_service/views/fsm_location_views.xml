<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_location_view_list" model="ir.ui.view">
        <field name="name">fsm.location.list</field>
        <field name="model">fsm.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="order_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_location_view_form" model="ir.ui.view">
        <field name="name">fsm.location.form</field>
        <field name="model">fsm.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_open_map" type="object" class="oe_stat_button" icon="fa-map-marker" invisible="not map_url">
                            <div class="o_stat_info"><span class="o_stat_text">Map</span></div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                            <field name="partner_latitude"/>
                            <field name="partner_longitude"/>
                        </group>
                    </group>
                    <field name="access_notes" placeholder="Location instructions, gate pass info, parking details..."/>
                    <field name="map_url" widget="url" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="fsm_location_action" model="ir.actions.act_window">
        <field name="name">Service Locations</field>
        <field name="res_model">fsm.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
