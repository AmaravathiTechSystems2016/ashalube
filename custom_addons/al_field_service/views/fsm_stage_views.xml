<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fsm_stage_view_list" model="ir.ui.view">
        <field name="name">fsm.stage.list</field>
        <field name="model">fsm.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="fold"/>
                <field name="is_closed"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">fsm.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="fsm_tag_view_form" model="ir.ui.view">
        <field name="name">fsm.tag.form</field>
        <field name="model">fsm.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fsm_tag_view_list" model="ir.ui.view">
        <field name="name">fsm.tag.list</field>
        <field name="model">fsm.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">fsm.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="fsm_skill_view_list" model="ir.ui.view">
        <field name="name">fsm.skill.list</field>
        <field name="model">fsm.skill</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="fsm_skill_action" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">fsm.skill</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
